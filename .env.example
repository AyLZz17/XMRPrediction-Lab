# Copy this file to .env and replace placeholders with independent random secrets.
USERS_DB_NAME=aylzz_users
USERS_DB_USER=aylzz_app
USERS_DB_PASSWORD=replace-with-a-random-database-password
USERS_DB_BACKUP_USER=users_backup_reader
USERS_DB_BACKUP_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
COOKIE_SECURE=false
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace-with-a-random-mongodb-admin-password
MONGO_MARKET_USER=market_service
MONGO_MARKET_PASSWORD=replace-with-a-random-market-database-password
MONGO_MARKET_BACKUP_USER=market_backup_reader
MONGO_MARKET_BACKUP_PASSWORD=
MONGO_PREDICTION_USER=prediction_service
MONGO_PREDICTION_PASSWORD=replace-with-a-random-prediction-database-password
MONGO_PREDICTION_BACKUP_USER=prediction_backup_reader
MONGO_PREDICTION_BACKUP_PASSWORD=
REDIS_PASSWORD=replace-with-a-random-redis-password

# Configure these before starting the optional --profile backup service.
BACKUP_SMTP_HOST=
BACKUP_SMTP_PORT=587
BACKUP_SMTP_USERNAME=
BACKUP_SMTP_PASSWORD=
BACKUP_SMTP_FROM=
BACKUP_EMAIL_TO=
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=900
BACKUP_MAX_ATTACHMENT_BYTES=18000000
